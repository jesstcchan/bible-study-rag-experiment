# Copy this file to .env and replace every placeholder before deployment.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Protect the oTree administrator interface and signed session data.
OTREE_ADMIN_PASSWORD=replace_with_a_long_random_admin_password
OTREE_SECRET_KEY=replace_with_a_different_long_random_secret
OTREE_AUTH_LEVEL=STUDY
OTREE_PRODUCTION=1
